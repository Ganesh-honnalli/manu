# ====================================================================
# SECOND SHELF - Environment Configuration
# ====================================================================

# 1. Supabase Connection (Leave blank to use built-in offline Demo Engine)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Supabase Service Role Key (Used strictly for server functions/edge functions, NEVER expose on frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Transactional Email Provider (Resend / SendGrid / Brevo)
# Configure in Supabase dashboard under Edge Functions Secrets
RESEND_API_KEY=re_your_api_key_here

# 4. Application URL
VITE_APP_URL=http://localhost:3000
